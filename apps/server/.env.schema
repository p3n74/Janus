# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @required=false @type=string
GOOGLE_CLIENT_ID=

# @required=false @type=string
GOOGLE_CLIENT_SECRET=

# Comma-separated emails. At least one of this or AUTH_ALLOWED_DOMAIN must be set or auth will not start.
# @required=false @type=string
AUTH_ALLOWED_EMAILS=

# Workspace domain without @, for example example.com. Used with the email allowlist.
# @required=false @type=string
AUTH_ALLOWED_DOMAIN=

# Comma-separated emails that receive the admin role when their user row is created.
# @required=false @type=string
AUTH_ADMIN_EMAILS=
